# Obsidian's vault config. Editor state and themes, not website content —
# the LYT Mode theme alone is ~880 KB and would be served publicly.
.obsidian/

# Claude Code's local preview config.
.claude/

# Python bytecode. The build workflow runs `git add -A`, so without this it
# commits fresh .pyc files on every single run.
__pycache__/
*.pyc

# OS clutter.
Thumbs.db
desktop.ini
.DS_Store
