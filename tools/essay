#!/usr/bin/env python3
"""One-command essay workflow: write, preview, publish.

    essay "My New Essay"     start a new essay: create it, open a local
                              preview in your browser, and offer to publish
                              when you're done writing
    essay publish [slug]     build, commit, and push — finds the one draft
                              in progress if you don't name a slug, or just
                              pushes whatever you've changed by hand
    essay discard [slug]     delete a draft you don't want to keep — finds
                              the one draft in progress if you don't name a
                              slug, and cleans up its local preview page too

Wraps tools/build.py, which does all the actual bookkeeping. See it for the
generated-file details; this script just automates the loop around it.
"""

import datetime as dt
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request

HERE = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
ROOT = os.path.dirname(HERE)
POSTS = os.path.join(ROOT, "posts")
BUILD_PY = os.path.join(HERE, "build.py")
SITE_URL = "https://dashrathkunwar.in"
PORT = 8000

# Running-document pages (see build.py's DOCS) aren't essays and must never be
# mistaken for a draft, even if their body text happens to contain a line that
# looks like front matter.
DOC_FILENAMES = {"home.md"}

DRAFT_LINE_RE = re.compile(r"^draft:\s*(true|yes|1)\s*$\n?", re.IGNORECASE | re.MULTILINE)


def front_matter_block(text):
    """Just the header between the --- fences, or "" if there isn't one.

    Draft-detection and title lookup must stay confined to this block —
    scanning the whole file would misfire on an essay whose body happens to
    quote a line like "draft: true" or "Title: ...".
    """
    if not text.lstrip().startswith("---"):
        return ""
    stripped = text.lstrip()
    end = stripped.find("\n---", 3)
    return stripped[3:end] if end != -1 else ""


def ensure_markdown_installed():
    try:
        import markdown  # noqa: F401
    except ImportError:
        print("Installing the 'markdown' package (one-time)...")
        try:
            subprocess.run([sys.executable, "-m", "pip", "install", "markdown"], check=True)
        except subprocess.CalledProcessError:
            sys.exit(
                "Couldn't install the 'markdown' package. Check your internet "
                "connection, then try again — or run:  pip install markdown"
            )


def slugify(title):
    s = title.lower()
    s = re.sub(r"[’‘'\"]", "", s)
    s = re.sub(r"[^a-z0-9]+", "-", s)
    return s.strip("-")


def run_build(drafts=False):
    args = [sys.executable, BUILD_PY] + (["--drafts"] if drafts else [])
    result = subprocess.run(args, cwd=ROOT, capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stdout)
        print(result.stderr, file=sys.stderr)
    return result.returncode == 0


def wait_for_server(url, tries=50):
    for _ in range(tries):
        try:
            urllib.request.urlopen(url, timeout=0.2)
            return True
        except Exception:
            time.sleep(0.1)
    return False


def watch_and_rebuild(path, stop_event):
    last = None
    while not stop_event.is_set():
        try:
            mtime = os.path.getmtime(path)
        except FileNotFoundError:
            mtime = None
        if mtime != last:
            last = mtime
            run_build(drafts=True)
        stop_event.wait(1)


def new_essay(title):
    ensure_markdown_installed()
    slug = slugify(title)
    if not slug:
        sys.exit("That title doesn't leave anything usable for a filename.")
    path = os.path.join(POSTS, f"{slug}.md")
    if os.path.exists(path):
        sys.exit(f"posts/{slug}.md already exists.")

    os.makedirs(POSTS, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(
            f"---\ntitle: {title}\ndate: {dt.date.today().isoformat()}\n"
            f"draft: true\n---\n\n"
        )
    print(f"Created posts/{slug}.md")

    run_build(drafts=True)

    server = subprocess.Popen(
        [sys.executable, "-m", "http.server", str(PORT), "--bind", "127.0.0.1", "--directory", ROOT],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    time.sleep(0.3)  # give it a moment to fail fast if the port's already taken
    if server.poll() is not None:
        sys.exit(
            f"Couldn't start the preview server — port {PORT} is probably already "
            f"in use by another 'essay' session. Finish or close that one first."
        )
    stop_event = threading.Event()
    watcher = threading.Thread(target=watch_and_rebuild, args=(path, stop_event), daemon=True)
    watcher.start()

    preview_url = f"http://127.0.0.1:{PORT}/writings/{slug}.html"
    print(f"Preview: {preview_url}")
    if wait_for_server(f"http://127.0.0.1:{PORT}/"):
        # Popen, not run: xdg-open often execs the browser itself and only
        # returns once it closes, which would block the whole script here.
        try:
            subprocess.Popen(["xdg-open", preview_url],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            print("(no xdg-open found — open the Preview URL above by hand)")
    else:
        print("(preview server slow to start — open the Preview URL above by hand)")

    try:
        input(f"Write posts/{slug}.md in your editor of choice — the preview "
              f"rebuilds on every save. Press Enter here when you're done. ")
    finally:
        print("Stopping preview...")
        stop_event.set()
        watcher.join()
        server.terminate()
        server.wait()

    run_build(drafts=True)

    answer = input("Publish now? [Y/n] ").strip().lower()
    if answer in ("", "y", "yes"):
        publish(slug)
    else:
        print(f"Draft saved. Resume anytime: essay publish {slug}")


def find_drafts():
    if not os.path.isdir(POSTS):
        return []
    drafts = []
    for name in sorted(os.listdir(POSTS)):
        if not name.lower().endswith((".md", ".markdown")):
            continue
        if name.lower() in DOC_FILENAMES:
            continue
        path = os.path.join(POSTS, name)
        with open(path, encoding="utf-8") as f:
            if DRAFT_LINE_RE.search(front_matter_block(f.read())):
                drafts.append(path)
    return drafts


def get_title(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    for line in front_matter_block(text).splitlines():
        if line.lower().startswith("title:"):
            return line.split(":", 1)[1].strip()
    return None


def strip_draft_flag(text):
    """Remove the draft: true line from the front-matter header, not the body."""
    if not text.lstrip().startswith("---"):
        return text, False
    lead = len(text) - len(text.lstrip())
    body = text.lstrip()
    end = body.find("\n---", 3)
    if end == -1:
        return text, False
    header, n = DRAFT_LINE_RE.subn("", body[3:end])
    if not n:
        return text, False
    return text[:lead] + "---" + header + body[end:], True


def has_unpushed_commits():
    result = subprocess.run(
        ["git", "rev-list", "--count", "@{u}..HEAD"],
        cwd=ROOT, capture_output=True, text=True,
    )
    return result.returncode == 0 and result.stdout.strip() != "0"


def discard(slug=None):
    if slug:
        path = os.path.join(POSTS, f"{slug}.md")
        if not os.path.exists(path):
            sys.exit(f"posts/{slug}.md not found.")
    else:
        targets = find_drafts()
        if not targets:
            sys.exit("No draft in progress to discard.")
        if len(targets) > 1:
            print("More than one draft in progress:")
            for p in targets:
                print(f"  {os.path.relpath(p, ROOT)}")
            sys.exit("Pass a slug: essay discard <slug>")
        path = targets[0]

    with open(path, encoding="utf-8") as f:
        is_draft = bool(DRAFT_LINE_RE.search(front_matter_block(f.read())))

    slug_out = os.path.splitext(os.path.basename(path))[0]
    title = get_title(path) or slug_out
    if is_draft:
        prompt = f'Delete draft "{title}" (posts/{slug_out}.md)? [y/N] '
    else:
        prompt = (
            f'"{title}" is already published, not a draft — deleting posts/{slug_out}.md '
            f'removes its source (it stays live on the site until your next publish). '
            f'Really delete? [y/N] '
        )
    if input(prompt).strip().lower() not in ("y", "yes"):
        print("Cancelled.")
        return

    os.remove(path)
    print(f"Deleted posts/{slug_out}.md")
    run_build(drafts=True)   # also clears out its local preview page
    print("Discarded.")


def publish(slug=None):
    if slug:
        path = os.path.join(POSTS, f"{slug}.md")
        if not os.path.exists(path):
            sys.exit(f"posts/{slug}.md not found.")
        targets = [path]
    else:
        targets = find_drafts()
        if len(targets) > 1:
            print("More than one draft in progress:")
            for p in targets:
                print(f"  {os.path.relpath(p, ROOT)}")
            sys.exit("Pass a slug: essay publish <slug>")

    title = None
    for path in targets:
        with open(path, encoding="utf-8") as f:
            text = f.read()
        stripped, changed = strip_draft_flag(text)
        if changed:
            with open(path, "w", encoding="utf-8") as f:
                f.write(stripped)
        title = title or get_title(path)

    print("Building...")
    if not run_build(drafts=False):
        sys.exit("Build failed, not publishing.")

    subprocess.run(["git", "add", "-A"], cwd=ROOT, check=True)
    status = subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=ROOT)
    has_staged_changes = status.returncode != 0

    if has_staged_changes:
        message = f"Publish: {title}" if title else "Update essays"
        print("Publishing...")
        subprocess.run(["git", "commit", "-m", message], cwd=ROOT, check=True)
    elif not has_unpushed_commits():
        print("Nothing to publish.")
        return
    else:
        print("Nothing new to commit, but a previous commit is still waiting to push...")

    try:
        subprocess.run(["git", "push"], cwd=ROOT, check=True)
    except subprocess.CalledProcessError:
        sys.exit(
            "Committed locally, but the push failed (no connection, or a git/SSH "
            "problem). Your essay is safe on this machine — once you're back "
            "online, just run:  essay publish"
        )

    if targets and len(targets) == 1:
        slug_out = os.path.splitext(os.path.basename(targets[0]))[0]
        print(f"Live: {SITE_URL}/writings/{slug_out}.html")
    else:
        print(f"Live: {SITE_URL}/writings.html")


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__)
    if args[0] == "publish":
        publish(args[1] if len(args) > 1 else None)
    elif args[0] == "discard":
        discard(args[1] if len(args) > 1 else None)
    else:
        new_essay(" ".join(args))


if __name__ == "__main__":
    main()
